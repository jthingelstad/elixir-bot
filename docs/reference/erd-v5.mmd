    members ||--o{ clan_memberships : "tenure"
    members ||--|| member_current_state : "1:1 latest"
    members ||--o{ member_state_snapshots : "history"
    members ||--o{ member_daily_metrics : "daily"
    members ||--o{ player_profile_snapshots : "profile"
    members ||--o{ member_card_collection_snapshots : "cards"
    members ||--o{ member_deck_snapshots : "decks"
    members ||--o{ member_card_usage_snapshots : "card usage"
    members ||--o{ member_battle_facts : "battles"
    members ||--o{ member_recent_form : "form"
    members ||--o{ member_daily_battle_rollups : "battle rollups"
    members ||--o{ awards : "awarded"

