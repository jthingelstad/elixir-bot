%% Elixir v5 primary database (elixir-v5.db) — Entity Relationship Diagram
%% Generated from the live schema. Scope: primary DB only.
%% Excluded: FTS5 shadow tables (clan_memories_fts_*) and sqlite-vec shadow
%% tables (clan_memory_vec_*) — these are auto-managed search indexes, not
%% domain entities. The event-stream and memory side databases are out of scope.
%% Legacy/dormant: game_event_stream and event_rollups (v4 leftovers, retained
%% only as link targets / historical data).
erDiagram
    %% ============================================================
    %% IDENTITY
    %% ============================================================
    members {
        int member_id PK
        text player_tag UK
        text current_name
        text status
        text first_seen_at
        text last_seen_at
    }
    member_metadata {
        int member_id PK,FK
        text joined_at
        int birth_month
        int birth_day
        text generated_bio
        int cr_account_age_days
        real cr_games_per_day
    }
    member_aliases {
        int alias_id PK
        int member_id FK
        text alias
        text source
    }
    discord_users {
        text discord_user_id PK
        text username
        text global_name
        text display_name
    }
    discord_links {
        int discord_link_id PK
        text discord_user_id FK
        int member_id FK
        real confidence
        int is_primary
    }
    discord_channels {
        text channel_id PK
        text channel_name
        text channel_kind
    }

    members ||--|| member_metadata : "1:1 profile"
    members ||--o{ member_aliases : "has"
    members ||--o{ discord_links : "linked via"
    discord_users ||--o{ discord_links : "linked via"

    %% ============================================================
    %% CONVERSATION + CONVERSATIONAL MEMORY
    %% ============================================================
    conversation_threads {
        int thread_id PK
        text scope_type
        text scope_key UK
        text channel_id FK
        text discord_user_id FK
        int member_id FK
    }
    messages {
        int message_id PK
        text discord_message_id UK
        int thread_id FK
        text channel_id FK
        text discord_user_id FK
        int member_id FK
        int intent_id "soft FK -> communication_intents"
        text author_type
        text workflow
        text content
    }
    memory_facts {
        int fact_id PK
        text subject_type
        text subject_key
        text fact_type
        int source_message_id FK
        text expires_at
    }
    memory_episodes {
        int episode_id PK
        text subject_type
        text subject_key
        text episode_type
        int importance
    }
    channel_state {
        text channel_id PK,FK
        text last_elixir_post_at
        text last_summary
    }
    prompt_feedback {
        int prompt_feedback_id PK
        int assistant_message_id FK
        text feedback_value
        text workflow
    }
    prompt_failures {
        int failure_id PK
        text workflow
        text failure_type
        text question
    }

    discord_channels ||--o{ conversation_threads : "scoped to"
    discord_users ||--o{ conversation_threads : "by user"
    members ||--o{ conversation_threads : "by member"
    conversation_threads ||--o{ messages : "contains"
    discord_channels ||--o{ messages : "in channel"
    discord_users ||--o{ messages : "from user"
    members ||--o{ messages : "from member"
    messages ||--o{ memory_facts : "sourced"
    messages ||--o{ prompt_feedback : "rated"
    discord_channels ||--|| channel_state : "1:1 state"

    %% ============================================================
    %% DURABLE SCOPED CLAN MEMORY (public / leadership / system)
    %% ============================================================
    clan_memories {
        int memory_id PK
        text source_type
        int is_inference
        real confidence
        text scope
        text status
        text body
        int member_id FK
        text member_tag
    }
    clan_memory_tags {
        int tag_id PK
        text tag UK
    }
    clan_memory_tag_links {
        int memory_id PK,FK
        int tag_id PK,FK
    }
    clan_memory_member_links {
        int memory_member_link_id PK
        int memory_id FK
        int member_id FK
        text relation_type
    }
    clan_memory_event_links {
        int memory_event_link_id PK
        int memory_id FK
        text event_type
        text event_id
    }
    clan_memory_evidence_refs {
        int evidence_ref_id PK
        int memory_id FK
        text evidence_type
        text evidence_ref
    }
    clan_memory_versions {
        int memory_version_id PK
        int memory_id FK
        int version_number
        text changed_by
    }
    clan_memory_audit_log {
        int audit_id PK
        int memory_id FK
        text action
    }
    clan_memory_embeddings {
        int memory_id PK,FK
        text embedding_model
        text vector_json
    }
    clan_memory_index_status {
        text key PK
        text value
    }

    members ||--o{ clan_memories : "about"
    clan_memories ||--o{ clan_memory_tag_links : "tagged"
    clan_memory_tags ||--o{ clan_memory_tag_links : "tags"
    clan_memories ||--o{ clan_memory_member_links : "links members"
    members ||--o{ clan_memory_member_links : "referenced"
    clan_memories ||--o{ clan_memory_event_links : "links events"
    clan_memories ||--o{ clan_memory_evidence_refs : "cites"
    clan_memories ||--o{ clan_memory_versions : "history"
    clan_memories ||--o{ clan_memory_audit_log : "audited"
    clan_memories ||--|| clan_memory_embeddings : "1:1 vector"

